# Firebase (client). Copier en .env.local et remplir avec la config Web du
# projet : `npx firebase apps:sdkconfig WEB --project pioneers-3627c`.
# Cette config est publique (elle finit dans le bundle) : la securite repose
# sur les regles Firestore.
#
# `npm run dev:emu` ignore ces valeurs et branche les emulateurs (projet
# `demo-pioneers-hub`, aucun projet reel touche).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pioneers-3627c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pioneers-3627c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pioneers-3627c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_EMULATORS=false
