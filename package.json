{
  "name": "pioneers-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_USE_EMULATORS=true NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pioneers-hub NEXT_PUBLIC_FIREBASE_API_KEY=demo-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-pioneers-hub.firebaseapp.com next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && npm --prefix functions run typecheck",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-pioneers-hub",
    "seed": "node scripts/seed.mjs",
    "check:rules": "npm --prefix functions run build && firebase emulators:exec --project demo-pioneers-hub --only auth,firestore,functions \"node scripts/seed.mjs && node scripts/check-rules.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project prod",
    "init:prod": "node scripts/init-prod.mjs",
    "grant": "node scripts/grant-role.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "dayjs": "^1.11.23",
    "firebase": "^13.2.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^14.27.0",
    "typescript": "^5"
  }
}
