rules_version = '2';

// ----------------------------
// Regles Firestore de Pioneers Hub
// ----------------------------
// MIROIR DE functions/src/shared/access.ts. Toute modification ici se reporte
// la-bas, et inversement (puis `npm run check:rules`). Qui voit quoi : SPECS §6.2.
//
// Principe : Firestore autorise ou refuse un document ENTIER. La visibilite se
// decide donc par le document ou l'on range un champ :
//   founders/{id}                    public si consentement, sinon batch + staff + investors
//   founders/{id}/private/directory  fondateurs du batch + staff + investors (Profile Book)
//   founders/{id}/private/profile    le fondateur lui-meme + staff + investors IC
//   founders/{id}/private/internal   staff + investors IC
//   startups/{id}                    public
//   startups/{id}/private/profile    membres + staff + investors
//   startups/{id}/private/internal   staff + investors IC
//
// Roles : `users/{uid}.roles` (staff, investor, mentor) et `investorAccess`
// (ic, portfolio). Fondateur d'un batch = `batchMemberships/{batchId}_{uid}` existe.
// « Insider » = staff ou investor IC.
//
// v1 : toutes les ecritures metier sont reservees au staff, ou passent par
// l'API (Cloud Functions, SDK admin) qui valide les donnees.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Fonctions ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function viewerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Identite du visiteur (people/{personId}), pour ses fiches mentor et investor.
    function viewerPerson() {
      return get(/databases/$(database)/documents/people/$(viewerUser().personId)).data;
    }

    function hasRole(role) {
      return signedIn() && viewerUser().get('roles', []).hasAny([role]);
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isInvestorIc() {
      return hasRole('investor') && viewerUser().get('investorAccess', null) == 'ic';
    }

    // Investor, quel que soit son niveau.
    function isInvestor() {
      return hasRole('investor') && viewerUser().get('investorAccess', null) in ['ic', 'portfolio'];
    }

    function isInsider() {
      return isStaff() || isInvestorIc();
    }

    function membershipPath(batchId) {
      return /databases/$(database)/documents/batchMemberships/$(batchId + '_' + request.auth.uid);
    }

    // Le visiteur est un fondateur de ce batch (compte rattache a un profil).
    function isBatchMember(batchId) {
      return signedIn() && exists(membershipPath(batchId));
    }

    // Le profil du visiteur dans ce batch.
    function viewerFounderId(batchId) {
      return get(membershipPath(batchId)).data.founderId;
    }

    // Le visiteur est le fondateur `founderId` de ce batch.
    function isViewerFounder(batchId, founderId) {
      return isBatchMember(batchId) && viewerFounderId(batchId) == founderId;
    }

    // Le visiteur est l'un des fondateurs `founderIds` de ce batch.
    function isViewerFounderIn(batchId, founderIds) {
      return isBatchMember(batchId) && founderIds.hasAny([viewerFounderId(batchId)]);
    }

    // Le visiteur est membre de la startup decrite par `data` (`batchId` + `memberIds`).
    function isMemberOf(data) {
      return isViewerFounderIn(data.batchId, data.memberIds);
    }

    function isStaffOrInvestor() {
      return isStaff() || isInvestor();
    }

    function founderData(founderId) {
      return get(/databases/$(database)/documents/founders/$(founderId)).data;
    }

    function startupData(startupId) {
      return get(/databases/$(database)/documents/startups/$(startupId)).data;
    }

    function personPath(personId) {
      return /databases/$(database)/documents/people/$(personId);
    }

    function founderPath(founderId) {
      return /databases/$(database)/documents/founders/$(founderId);
    }

    // L'email VERIFIE du compte est celui de la personne (ou l'un de ses
    // `altEmails`) : c'est la cle du rattachement automatique (SPECS §3.1).
    // `people.email` est stocke en minuscules.
    function emailMatches(person) {
      return signedIn()
        && request.auth.token.email_verified == true
        && (person.email == request.auth.token.email.lower()
            || person.get('altEmails', []).hasAny([request.auth.token.email.lower()]));
    }

    // Seuls ces champs changent (et l'horodatage).
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(keys.concat(['updatedDateISOString']));
    }

    // La personne `person` est celle du profil que ce compte reclame dans ce lot
    // (son DERNIER profil : celui du batch le plus recent).
    function claimsLastFounderOf(person) {
      return person.founderIds.size() > 0
        && getAfter(founderPath(person.founderIds[person.founderIds.size() - 1])).data.uid == request.auth.uid;
    }

    // Une copie (`private/directory`) ecrite par le fondateur egale l'original
    // dans `people`, ecrit dans le meme lot.
    function copyMatches(personId, key) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([key])
        || request.resource.data.get(key, null) == getAfter(personPath(personId)).data.get(key, null);
    }

    // ---- Comptes -----------------------------------------------------------

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      // Creation par le compte lui-meme, sans aucun role.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.roles == []
        && request.resource.data.personId == null
        && request.resource.data.investorAccess == null;
      // Mise a jour par le compte lui-meme, sans toucher aux droits. `personId`
      // ne change que vers une personne que ce compte reclame dans le meme lot.
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'investorAccess'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['personId'])
            || getAfter(personPath(request.resource.data.personId)).data.uid == request.auth.uid);
      allow update: if isStaff();
    }

    // Identite : la personne elle-meme + staff + investors IC. Les champs que
    // d'autres doivent voir sont recopies dans les documents lisibles par eux.
    match /people/{personId} {
      // La personne elle-meme : par son compte rattache, ou par son email (une
      // requete `where email == <email du compte>` avant le rattachement).
      allow read: if isInsider()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || emailMatches(resource.data);
      allow write: if isStaff();
      // Rattachement : par email, ou en meme temps que le profil choisi dans la liste.
      allow update: if resource.data.uid == null
        && request.resource.data.uid == request.auth.uid
        && (emailMatches(resource.data) || claimsLastFounderOf(resource.data))
        && onlyChanges(['uid']);
      // Coordonnees modifiees par la personne (FOUNDER_SELF_EDITABLE.person).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && onlyChanges(['phone', 'whatsapp', 'linkedinUrl']);
    }

    match /batchMemberships/{membershipId} {
      // Lecture de SON lien (id deterministe `{batchId}_{uid}`), meme s'il n'existe pas encore.
      allow get: if signedIn() && membershipId.matches('^.+_' + request.auth.uid + '$');
      // Tous SES liens (accueil : dans quel batch suis-je fondateur ?).
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow read, write: if isStaff();
      // Rattachement automatique : cree dans le MEME lot que la reclamation du
      // profil (`founders.uid` passe de null au compte). `get` lit l'etat avant
      // le lot, `getAfter` l'etat apres.
      allow create: if signedIn()
        && membershipId == request.resource.data.batchId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && get(founderPath(request.resource.data.founderId)).data.uid == null
        && getAfter(founderPath(request.resource.data.founderId)).data.uid == request.auth.uid
        && getAfter(founderPath(request.resource.data.founderId)).data.batchId == request.resource.data.batchId
        && getAfter(founderPath(request.resource.data.founderId)).data.programId == request.resource.data.programId;
    }

    // Demandes de rattachement par choix du profil, validees par le staff.
    match /claimRequests/{requestId} {
      allow get: if signedIn() && requestId.matches('^.+_' + request.auth.uid + '$');
      allow list: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isStaff();
      // Le compte demande un profil non reclame d'un batch dont il n'est pas
      // deja fondateur ; il peut changer de profil tant que ce n'est pas valide.
      // Email VERIFIE : le staff valide en lisant cet email, il doit etre prouve.
      allow create, update: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email.lower()
        && requestId == request.resource.data.batchId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.decidedByUid == null
        && (resource == null || resource.data.status != 'approved')
        && founderData(request.resource.data.founderId).uid == null
        && founderData(request.resource.data.founderId).batchId == request.resource.data.batchId
        && !isBatchMember(request.resource.data.batchId);
    }

    match /apiKeys/{keyId} {
      allow read: if isStaff();
      allow write: if false; // callable (empreinte de la cle calculee cote serveur)
    }

    // ---- Programmes et batchs : publics --------------------------------------

    match /programs/{programId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /batchStats/{batchId} {
      allow read: if true;
      allow write: if false; // Cloud Functions (SDK admin) uniquement
    }

    match /lists/{listKey} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---- Fondateurs --------------------------------------------------------

    match /founders/{founderId} {
      // Une requete publique DOIT filtrer sur publicProfileConsent == true.
      allow read: if resource.data.publicProfileConsent == true
        || isStaff()
        || isInvestor()
        || isBatchMember(resource.data.batchId);
      // Profils non reclames : liste « choisir mon profil » (une requete doit
      // filtrer `uid == null`). Nom, photo, competences : la carte minimale.
      allow read: if signedIn() && resource.data.uid == null;
      allow write: if isStaff();
      // Rattachement (decision du 11/11, « comme Tricount ») : un compte a l'email
      // VERIFIE reclame un profil non reclame, par email ou en le choisissant
      // dans la liste, un seul par batch. Le staff voit chaque rattachement
      // (Staff > Access) et peut delier.
      allow update: if resource.data.uid == null
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email_verified == true
        && !isBatchMember(resource.data.batchId)
        && onlyChanges(['uid', 'claimedDateISOString']);
      // « Mon profil » (FOUNDER_SELF_EDITABLE.founder).
      allow update: if isViewerFounder(resource.data.batchId, founderId)
        && onlyChanges(['hardSkills', 'industries', 'rolesICouldTake', 'publicProfileConsent']);

      match /private/{docId} {
        allow read: if
          (docId == 'directory' && (isStaffOrInvestor() || isBatchMember(founderData(founderId).batchId)))
          || (docId == 'profile' && (isInsider()
              || (signedIn() && founderData(founderId).uid == request.auth.uid)))
          || (docId == 'internal' && isInsider());
        allow write: if isStaff();
        // « Mon profil » (FOUNDER_SELF_EDITABLE.founderDirectory et .founderProfile).
        allow update: if docId == 'directory'
          && isViewerFounder(founderData(founderId).batchId, founderId)
          && onlyChanges([
            'whatsapp', 'linkedinUrl', 'phone', 'gender', 'nationality', 'country', 'introduceYourself',
            'education', 'degree', 'fieldOfStudy', 'yearsOfXP', 'notableCompanies', 'trackRecord',
            'interestedInWorkingOn', 'hasExistingProject', 'projectExplanation', 'hasExistingCoFounders',
            'openToJoinAnotherProject', 'mainStartup2025', 'lookingForCoFounder', 'coFounderTypeWanted',
            'coFounderSkillsWanted', 'industriesToExplore'])
          && copyMatches(founderData(founderId).personId, 'whatsapp')
          && copyMatches(founderData(founderId).personId, 'linkedinUrl')
          && copyMatches(founderData(founderId).personId, 'phone');
        allow update: if docId == 'profile'
          && isViewerFounder(founderData(founderId).batchId, founderId)
          && onlyChanges(['housingSupport', 'tShirtSize']);
      }
    }

    // Suivi hebdomadaire : le fondateur lui-meme + staff + investors IC.
    match /founderWeeks/{weekId} {
      allow read: if isInsider() || isViewerFounder(resource.data.batchId, resource.data.founderId);
      allow write: if isStaff();
    }

    match /founderStats/{founderId} {
      allow read: if isInsider();
      allow write: if false;
    }

    match /picks/{pickId} {
      allow read: if isStaff() || isViewerFounder(resource.data.batchId, resource.data.founderId);
      allow write: if isStaff();
    }

    // ---- Startups ----------------------------------------------------------

    match /startups/{startupId} {
      allow read: if true;
      allow write: if isStaff();

      match /private/{docId} {
        allow read: if
          (docId == 'profile' && (isStaffOrInvestor() || isMemberOf(startupData(startupId))))
          || (docId == 'internal' && isInsider());
        allow write: if isStaff();
      }
    }

    // Update du jeudi : membres + staff + investors.
    match /checkins/{checkinId} {
      allow read: if isStaffOrInvestor() || isMemberOf(resource.data);
      allow write: if isStaff();
    }

    // Releves de metriques : fondateurs concernes + staff + investors.
    match /metricSnapshots/{snapshotId} {
      allow read: if isStaffOrInvestor() || isViewerFounderIn(resource.data.batchId, resource.data.founderIds);
      allow write: if isStaff();
    }

    // Appartenances datees aux equipes : fondateurs du batch + staff + investors.
    match /memberships/{membershipId} {
      allow read: if isStaffOrInvestor() || isBatchMember(resource.data.batchId);
      allow write: if isStaff();
    }

    match /kpiSeries/{startupId} {
      allow read: if isStaffOrInvestor() || isMemberOf(resource.data);
      allow write: if false;
    }

    // ---- Evenements --------------------------------------------------------

    match /events/{eventId} {
      allow read: if true;
      allow write: if isStaff();

      // Une equipe n'est publique qu'une fois publiee (une requete publique doit
      // filtrer `publishedDateISOString != null`).
      match /teams/{teamId} {
        allow read: if resource.data.publishedDateISOString != null || isInsider();
        allow write: if isStaff();
      }

      match /submissions/{teamId} {
        allow read: if true;
        allow write: if isStaff();
      }

      // Notes du jury et presences : staff + investors IC. Les jures (sans
      // compte) et les fondateurs ecriront via l'API.
      match /evaluations/{evaluationId} {
        allow read: if isInsider();
        allow write: if isStaff();
      }

      match /attendance/{founderId} {
        allow read: if isInsider();
        allow write: if isStaff();
      }

      // Jetons des jures, avis entre pairs individuels : staff seulement.
      match /judges/{judgeId} {
        allow read, write: if isStaff();
      }

      // L'auteur relit les siens donnes (SPECS §6.2), jamais ceux recus.
      match /peerRatings/{ratingId} {
        allow read: if isStaff() || isViewerFounder(resource.data.batchId, resource.data.raterFounderId);
        allow write: if isStaff();
      }
    }

    // Note en un geste par seance : staff + investors IC ; l'auteur relit la sienne.
    match /sessionRatings/{ratingId} {
      allow read: if isInsider() || isViewerFounder(resource.data.batchId, resource.data.founderId);
      allow write: if isStaff();
    }

    match /eventStats/{eventId} {
      allow read: if isInsider();
      allow write: if false;
    }

    // Visible de tous tant que le reglage du batch le permet ; masque pendant
    // les mutual picks, sauf pour le staff et les investors.
    match /leaderboards/{eventId} {
      allow read: if isStaffOrInvestor()
        || get(/databases/$(database)/documents/batches/$(resource.data.batchId))
            .data.settings.leaderboardVisibility == 'visible';
      allow write: if false;
    }

    // Requetes de groupe (fiche fondateur, fiche startup) : presences d'un
    // fondateur sur toutes les seances, notes recues par une startup.
    match /{path=**}/attendance/{founderId} {
      allow read: if isInsider();
    }
    match /{path=**}/evaluations/{evaluationId} {
      allow read: if isInsider();
    }

    // ---- Formulaires -------------------------------------------------------

    match /forms/{formId} {
      // Formulaires publics, sans compte (lien partage).
      allow read: if true;
      allow write: if isStaff();

      match /versions/{version} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /formResponses/{responseId} {
      // Les investors IC lisent tout SAUF le feedback entre pairs : une requete
      // IC doit donc filtrer `formKind != 'peer_feedback'`.
      allow read: if isStaff()
        || (isInvestorIc() && resource.data.formKind != 'peer_feedback');
      allow write: if isStaff();
    }

    // Suggestions de Claude (MCP) : staff, qui les accepte ou les rejette.
    match /fieldSuggestions/{suggestionId} {
      allow read, write: if isStaff();
    }

    // Champs manquants : staff + investors IC.
    match /completeness/{completenessId} {
      allow read: if isInsider();
      allow write: if false;
    }

    // ---- Evaluation interne ------------------------------------------------

    // Sous-scores (non ponderes) : staff + investors des deux niveaux.
    match /scores/{scoreId} {
      allow read: if isStaffOrInvestor();
      allow write: if false;
    }

    // Detail des sous-scores : contient des appreciations du staff.
    match /scoreSignals/{scoreId} {
      allow read: if isInsider();
      allow write: if false;
    }

    match /eloMatches/{matchId} {
      allow read: if isInsider();
      allow write: if false;
    }

    match /notes/{noteId} {
      allow read: if isInsider();
      allow write: if isStaff();
    }

    // Fiches d'evaluation generees : le staff voit tout ; les investors IC ne
    // voient que les fiches VALIDEES (une requete IC doit filtrer status == 'validated').
    match /assessments/{assessmentId} {
      allow read: if isStaff() || (isInvestorIc() && resource.data.status == 'validated');
      allow write: if isStaff();
    }

    // ---- Mentors et investors (fonctions en bonus, base prete) ---------------

    match /mentors/{mentorId} {
      allow read: if isInsider();
      allow write: if isStaff();
    }

    match /mentorPicks/{pickId} {
      allow read: if isStaff()
        || (hasRole('mentor') && viewerPerson().get('mentorId', null) == resource.data.mentorId);
      allow write: if isStaff();
    }

    match /startupMentorPicks/{startupId} {
      allow read: if isStaff() || isMemberOf(startupData(startupId));
      allow write: if isStaff();
    }

    match /mentorships/{mentorshipId} {
      allow read: if isInsider()
        || isMemberOf(resource.data)
        || (hasRole('mentor') && viewerPerson().get('mentorId', null) == resource.data.mentorId);
      allow write: if isStaff();
    }

    match /mentorFeedback/{feedbackId} {
      allow read, write: if isStaff();
    }

    match /investors/{investorId} {
      allow read: if isInsider();
      allow write: if isStaff();
    }

    match /investments/{investmentId} {
      allow read: if isInsider()
        || (isInvestor() && resource.data.investorIds.hasAny([viewerPerson().get('investorId', '')]));
      allow write: if isStaff();
    }

    match /portfolioReports/{reportId} {
      allow read: if isStaffOrInvestor() || isMemberOf(resource.data);
      allow write: if isStaff();
    }

    // ---- Systeme -----------------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
