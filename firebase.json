{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9399
    },
    "functions": {
      "port": 5101
    },
    "hosting": {
      "port": 5102
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    },
    "ui": {
      "enabled": true,
      "port": 4100
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "site": "pioneers-hub-api",
      "public": "api-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/.well-known/**",
          "function": {
            "functionId": "api",
            "region": "europe-west4"
          }
        },
        {
          "source": "**",
          "function": {
            "functionId": "api",
            "region": "europe-west4"
          }
        }
      ]
    }
  ]
}
